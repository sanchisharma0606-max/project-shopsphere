# ShopSphere Environment Configuration Template
# Copy this file to .env or configure your environment variables accordingly.

# MySQL Database Configuration
SHOPSPHERE_DB_URL=jdbc:mysql://localhost:3306/shopsphere?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SHOPSPHERE_DB_USER=root
SHOPSPHERE_DB_PASSWORD=your_mysql_password_here

# Network Module Configuration
SHOPSPHERE_SOCKET_PORT=9090
SHOPSPHERE_SOCKET_HOST=localhost

# RMI Service Configuration
SHOPSPHERE_RMI_PORT=1099
SHOPSPHERE_RMI_HOST=localhost
SHOPSPHERE_RMI_SERVICE_NAME=InventoryService

# Application Security
SHOPSPHERE_SESSION_TIMEOUT_MINUTES=30
